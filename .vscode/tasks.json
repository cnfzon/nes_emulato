{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "cargo build (workspace)",
            "type": "shell",
            "command": "cargo",
            "args": ["build", "--workspace"],
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$rustc"]
        },
        {
            "label": "cargo test (workspace)",
            "type": "shell",
            "command": "cargo",
            "args": ["test", "--workspace"],
            "group": { "kind": "test", "isDefault": true },
            "problemMatcher": ["$rustc"]
        },
        {
            "label": "cargo clippy (workspace)",
            "type": "shell",
            "command": "cargo",
            "args": ["clippy", "--workspace", "--all-targets", "--", "-D", "warnings"],
            "group": "build",
            "problemMatcher": ["$rustc"]
        },
        {
            "label": "cargo run (nes-app)",
            "type": "shell",
            "command": "cargo",
            "args": ["run", "-p", "nes-app"],
            "group": "build",
            "problemMatcher": ["$rustc"]
        }
    ]
}
